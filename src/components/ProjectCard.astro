---
interface Props {
  title:       string;
  hook:        string;
  description: string;
  features:    string[];
  tags:        string[];
  href?:       string;
  github?:     string;
  status:      'live' | 'wip' | 'archived';
  variant:     string;
  learned?:    string;
}

const {
  title,
  hook,
  description,
  features,
  tags,
  href,
  github,
  status = 'live',
  variant,
  learned,
} = Astro.props;

const modalId = `modal-${title.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '')}`;

const statusLabel: Record<string, string> = {
  live:     'Live',
  wip:      'In progress',
  archived: 'Archived',
};

const statusStyle: Record<string, string> = {
  live:     'background: rgba(74,222,128,0.12); color: #4ade80; border: 1px solid rgba(74,222,128,0.28)',
  wip:      'background: rgba(20,184,166,0.12); color: #14b8a6; border: 1px solid rgba(20,184,166,0.28)',
  archived: 'background: rgba(100,116,139,0.12); color: #94a3b8; border: 1px solid rgba(100,116,139,0.28)',
};
---

<article class="card flex flex-col overflow-hidden">

  <!-- ── Hero placeholder ──────────────────────────────────── -->
  <div class="relative overflow-hidden" style="aspect-ratio: 16/9;">

    {variant === 'littrack' && (
      <svg
        viewBox="0 0 400 225"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-full"
        style="background: #0c1829;"
        aria-hidden="true"
      >
        <!-- Subtle grid -->
        <line x1="0" y1="45"  x2="400" y2="45"  stroke="#1e2937" stroke-width="0.8"/>
        <line x1="0" y1="90"  x2="400" y2="90"  stroke="#1e2937" stroke-width="0.8"/>
        <line x1="0" y1="135" x2="400" y2="135" stroke="#1e2937" stroke-width="0.8"/>
        <line x1="0" y1="180" x2="400" y2="180" stroke="#1e2937" stroke-width="0.8"/>

        <!-- Open book (left panel) -->
        <rect x="20" y="20" width="118" height="180" rx="6" fill="#1e2937" stroke="#2d3f54" stroke-width="1"/>
        <line x1="45" y1="20" x2="45" y2="200" stroke="#14b8a6" stroke-width="0.8" opacity="0.25"/>
        <rect x="34" y="34" width="96" height="4"  rx="2" fill="#14b8a6" opacity="0.55"/>
        <rect x="34" y="46" width="72" height="2.5" rx="1.2" fill="#334155"/>
        <rect x="34" y="54" width="84" height="2.5" rx="1.2" fill="#334155"/>
        <rect x="34" y="62" width="60" height="2.5" rx="1.2" fill="#334155"/>
        <rect x="34" y="70" width="78" height="2.5" rx="1.2" fill="#334155"/>
        <rect x="34" y="78" width="66" height="2.5" rx="1.2" fill="#334155"/>
        <rect x="34" y="86" width="80" height="2.5" rx="1.2" fill="#334155"/>
        <rect x="34" y="94" width="56" height="2.5" rx="1.2" fill="#334155"/>

        <!-- Progress section header -->
        <text x="158" y="38" font-family="monospace" font-size="9" fill="#64748b" letter-spacing="2">READING PROGRESS</text>

        <!-- Student rows -->
        <text x="158" y="62" font-family="monospace" font-size="8.5" fill="#94a3b8">Student A</text>
        <rect x="236" y="54" width="140" height="9" rx="4.5" fill="#0f172a"/>
        <rect x="236" y="54" width="119" height="9" rx="4.5" fill="#14b8a6" opacity="0.65"/>
        <text x="384" y="63" font-family="monospace" font-size="8.5" fill="#14b8a6" text-anchor="end">85%</text>

        <text x="158" y="86" font-family="monospace" font-size="8.5" fill="#94a3b8">Student B</text>
        <rect x="236" y="78" width="140" height="9" rx="4.5" fill="#0f172a"/>
        <rect x="236" y="78" width="94" height="9"  rx="4.5" fill="#14b8a6" opacity="0.42"/>
        <text x="384" y="87" font-family="monospace" font-size="8.5" fill="#64748b" text-anchor="end">67%</text>

        <text x="158" y="110" font-family="monospace" font-size="8.5" fill="#94a3b8">Student C</text>
        <rect x="236" y="102" width="140" height="9" rx="4.5" fill="#0f172a"/>
        <rect x="236" y="102" width="132" height="9" rx="4.5" fill="#14b8a6" opacity="0.78"/>
        <text x="384" y="111" font-family="monospace" font-size="8.5" fill="#14b8a6" text-anchor="end">94%</text>

        <text x="158" y="134" font-family="monospace" font-size="8.5" fill="#94a3b8">Student D</text>
        <rect x="236" y="126" width="140" height="9" rx="4.5" fill="#0f172a"/>
        <rect x="236" y="126" width="55"  height="9" rx="4.5" fill="#14b8a6" opacity="0.32"/>
        <text x="384" y="135" font-family="monospace" font-size="8.5" fill="#64748b" text-anchor="end">39%</text>

        <!-- Stat cards -->
        <rect x="158" y="158" width="66" height="40" rx="6" fill="#1e2937" stroke="#2d3f54" stroke-width="1"/>
        <text x="191" y="175" font-family="monospace" font-size="15" fill="#14b8a6" text-anchor="middle" font-weight="bold">24</text>
        <text x="191" y="190" font-family="monospace" font-size="7.5" fill="#64748b" text-anchor="middle">books</text>

        <rect x="234" y="158" width="66" height="40" rx="6" fill="#1e2937" stroke="#2d3f54" stroke-width="1"/>
        <text x="267" y="175" font-family="monospace" font-size="15" fill="#4ade80" text-anchor="middle" font-weight="bold">18</text>
        <text x="267" y="190" font-family="monospace" font-size="7.5" fill="#64748b" text-anchor="middle">students</text>

        <rect x="310" y="158" width="66" height="40" rx="6" fill="#1e2937" stroke="#2d3f54" stroke-width="1"/>
        <text x="343" y="175" font-family="monospace" font-size="15" fill="#14b8a6" text-anchor="middle" font-weight="bold">71%</text>
        <text x="343" y="190" font-family="monospace" font-size="7.5" fill="#64748b" text-anchor="middle">avg.</text>
      </svg>
    )}

    {variant === 'lovund' && (
      <svg
        viewBox="0 0 400 225"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-full"
        style="background: #09152a;"
        aria-hidden="true"
      >
        <!-- Stars -->
        <circle cx="178" cy="13"  r="0.8" fill="#e2e8f0" opacity="0.3"/>
        <circle cx="214" cy="7"   r="0.6" fill="#e2e8f0" opacity="0.22"/>
        <circle cx="252" cy="19"  r="1"   fill="#e2e8f0" opacity="0.38"/>
        <circle cx="294" cy="9"   r="0.8" fill="#e2e8f0" opacity="0.28"/>
        <circle cx="326" cy="23"  r="1.1" fill="#e2e8f0" opacity="0.42"/>
        <circle cx="360" cy="13"  r="0.7" fill="#e2e8f0" opacity="0.28"/>
        <circle cx="382" cy="34"  r="0.6" fill="#e2e8f0" opacity="0.2"/>
        <circle cx="192" cy="33"  r="0.6" fill="#e2e8f0" opacity="0.18"/>
        <circle cx="274" cy="30"  r="0.7" fill="#e2e8f0" opacity="0.24"/>
        <circle cx="344" cy="40"  r="0.5" fill="#e2e8f0" opacity="0.18"/>
        <circle cx="234" cy="41"  r="0.6" fill="#e2e8f0" opacity="0.17"/>

        <!-- Moon — top right -->
        <circle cx="374" cy="30" r="15" fill="none" stroke="#14b8a6" stroke-width="0.8" opacity="0.15"/>
        <circle cx="374" cy="30" r="9"  fill="#14b8a6" opacity="0.06"/>
        <circle cx="374" cy="30" r="4"  fill="#14b8a6" opacity="0.18"/>

        <!-- Island silhouette -->
        <path d="M 192 150 Q 224 100 260 110 Q 278 88 308 103 Q 332 90 352 114 L 364 150 Z" fill="#132035"/>

        <!-- Gear shed — flat roof, more storage-like -->
        <rect x="262" y="108" width="54" height="34" rx="2" fill="#1e2d45" stroke="#2d3f54" stroke-width="1"/>
        <polygon points="257,108 322,108 322,102 289,93 257,102" fill="#162d40" stroke="#2d3f54" stroke-width="0.8"/>
        <!-- Double shed doors -->
        <rect x="274" y="124" width="12" height="18" rx="1" fill="#09152a" opacity="0.9"/>
        <rect x="287" y="124" width="12" height="18" rx="1" fill="#09152a" opacity="0.9"/>
        <!-- Side window -->
        <rect x="262" y="114" width="9" height="7" rx="1" fill="#14b8a6" opacity="0.18"/>
        <rect x="305" y="114" width="9" height="7" rx="1" fill="#14b8a6" opacity="0.18"/>
        <!-- Door light -->
        <circle cx="286" cy="122" r="2" fill="#14b8a6" opacity="0.32"/>

        <!-- Kayaks resting on shore near water line -->
        <ellipse cx="218" cy="149" rx="22" ry="4"   fill="#14b8a6" opacity="0.22" transform="rotate(-9 218 149)"/>
        <ellipse cx="228" cy="153" rx="19" ry="3.5" fill="#14b8a6" opacity="0.17" transform="rotate(-7 228 153)"/>

        <!-- Water -->
        <path d="M 0 158 Q 50 150 100 158 Q 150 166 200 158 Q 250 150 300 158 Q 350 166 400 158 L 400 225 L 0 225 Z" fill="#0d2040" opacity="0.85"/>
        <path d="M 0 170 Q 40 162 80 170 Q 120 178 160 170 Q 200 162 240 170 Q 280 178 320 170 Q 360 162 400 170 L 400 225 L 0 225 Z" fill="#091830"/>

        <!-- Water shimmer -->
        <path d="M 44 174 Q 68 171 92 174"   stroke="#14b8a6" stroke-width="1.5" opacity="0.2" stroke-linecap="round"/>
        <path d="M 184 179 Q 218 176 252 179" stroke="#14b8a6" stroke-width="1.5" opacity="0.18" stroke-linecap="round"/>
        <path d="M 304 173 Q 338 170 372 173" stroke="#14b8a6" stroke-width="1"   opacity="0.15" stroke-linecap="round"/>
        <!-- Moon reflection -->
        <path d="M 360 193 Q 374 189 388 193" stroke="#14b8a6" stroke-width="1.2" opacity="0.2" stroke-linecap="round"/>

        <!-- ── Shop card ── -->
        <rect x="14" y="12" width="146" height="164" rx="8" fill="#0e1e30" stroke="#2d3f54" stroke-width="1"/>

        <!-- Header -->
        <text x="26" y="30" font-family="monospace" font-size="8.5" fill="#14b8a6" letter-spacing="1.5">GEAR RENTAL</text>
        <line x1="14" y1="37" x2="160" y2="37" stroke="#2d3f54" stroke-width="0.8"/>

        <!-- Row 1 — Kayak -->
        <!-- icon: thin canoe ellipse -->
        <ellipse cx="33" cy="51" rx="10" ry="3.5" fill="#14b8a6" opacity="0.6"/>
        <text x="50" y="55"  font-family="monospace" font-size="8.5" fill="#e2e8f0">Kayak</text>
        <text x="130" y="55" font-family="monospace" font-size="8"   fill="#64748b" text-anchor="end">299 kr</text>
        <rect x="133" y="44" width="16" height="14" rx="3" fill="#1e2d45" stroke="#2d3f54" stroke-width="0.8"/>
        <text x="141" y="55" font-family="monospace" font-size="11"  fill="#14b8a6" text-anchor="middle">+</text>
        <line x1="24" y1="65" x2="156" y2="65" stroke="#1a2d40" stroke-width="0.6"/>

        <!-- Row 2 — SUP Board -->
        <!-- icon: wider board + person dot -->
        <ellipse cx="33" cy="79" rx="11" ry="3" fill="#14b8a6" opacity="0.5"/>
        <circle  cx="33" cy="74" r="2"          fill="#14b8a6" opacity="0.4"/>
        <text x="50" y="83"  font-family="monospace" font-size="8.5" fill="#e2e8f0">SUP Board</text>
        <text x="130" y="83" font-family="monospace" font-size="8"   fill="#64748b" text-anchor="end">249 kr</text>
        <rect x="133" y="72" width="16" height="14" rx="3" fill="#1e2d45" stroke="#2d3f54" stroke-width="0.8"/>
        <text x="141" y="83" font-family="monospace" font-size="11"  fill="#14b8a6" text-anchor="middle">+</text>
        <line x1="24" y1="93" x2="156" y2="93" stroke="#1a2d40" stroke-width="0.6"/>

        <!-- Row 3 — E-Scooter -->
        <!-- icon: two wheels + body line + handlebar -->
        <circle cx="26" cy="107" r="4"   fill="none" stroke="#14b8a6" stroke-width="1.2" opacity="0.6"/>
        <circle cx="39" cy="107" r="4"   fill="none" stroke="#14b8a6" stroke-width="1.2" opacity="0.6"/>
        <line x1="26" y1="107" x2="34"  y2="100" stroke="#14b8a6" stroke-width="1.2" opacity="0.6"/>
        <line x1="34" y1="100" x2="41"  y2="100" stroke="#14b8a6" stroke-width="1.2" opacity="0.6"/>
        <line x1="26" y1="107" x2="38"  y2="107" stroke="#14b8a6" stroke-width="0.8" opacity="0.35"/>
        <text x="50" y="111"  font-family="monospace" font-size="8.5" fill="#e2e8f0">E-Scooter</text>
        <text x="130" y="111" font-family="monospace" font-size="8"   fill="#64748b" text-anchor="end">199 kr</text>
        <rect x="133" y="100" width="16" height="14" rx="3" fill="#1e2d45" stroke="#2d3f54" stroke-width="0.8"/>
        <text x="141" y="111" font-family="monospace" font-size="11"  fill="#14b8a6" text-anchor="middle">+</text>
        <line x1="24" y1="121" x2="156" y2="121" stroke="#1a2d40" stroke-width="0.6"/>

        <!-- Row 4 — Bike -->
        <!-- icon: two wheels + frame triangle + handlebars -->
        <circle cx="26" cy="134" r="5"    fill="none" stroke="#14b8a6" stroke-width="1.2" opacity="0.6"/>
        <circle cx="39" cy="134" r="5"    fill="none" stroke="#14b8a6" stroke-width="1.2" opacity="0.6"/>
        <path d="M 26,134 L 32.5,127 L 39,134" fill="none" stroke="#14b8a6" stroke-width="1.2" opacity="0.6"/>
        <line x1="32.5" y1="127" x2="32.5" y2="123" stroke="#14b8a6" stroke-width="1.2" opacity="0.5"/>
        <line x1="29.5" y1="123" x2="35.5" y2="123" stroke="#14b8a6" stroke-width="1.2" opacity="0.5"/>
        <text x="50" y="138"  font-family="monospace" font-size="8.5" fill="#e2e8f0">Bike</text>
        <text x="130" y="138" font-family="monospace" font-size="8"   fill="#64748b" text-anchor="end">149 kr</text>
        <rect x="133" y="127" width="16" height="14" rx="3" fill="#1e2d45" stroke="#2d3f54" stroke-width="0.8"/>
        <text x="141" y="138" font-family="monospace" font-size="11"  fill="#14b8a6" text-anchor="middle">+</text>

        <!-- Divider + pay button -->
        <line x1="14" y1="149" x2="160" y2="149" stroke="#2d3f54" stroke-width="0.8"/>
        <rect x="20" y="154" width="134" height="16" rx="5" fill="#14b8a6" opacity="0.9"/>
        <text x="87" y="165.5" font-family="monospace" font-size="8" fill="#0f172a" text-anchor="middle" font-weight="bold">Pay with Stripe</text>
      </svg>
    )}

    <!-- Status badge overlay -->
    <span
      class="absolute top-3 right-3 text-xs font-medium px-2.5 py-0.5 rounded-full"
      style={statusStyle[status]}
    >
      {statusLabel[status]}
    </span>
  </div>

  <!-- ── Card body ──────────────────────────────────────────── -->
  <div class="p-5 flex flex-col gap-3 flex-1">

    <!-- Title -->
    <h3 class="text-xl font-bold leading-tight" style="color: var(--color-text)">{title}</h3>

    <!-- Hook -->
    <p class="text-sm leading-relaxed" style="color: var(--color-muted)">{hook}</p>

    <!-- Feature bullets -->
    <ul class="space-y-1.5">
      {features.map(f => (
        <li class="flex items-start gap-2 text-sm" style="color: var(--color-muted)">
          <span class="flex-shrink-0 mt-px font-bold" style="color: var(--color-accent)">→</span>
          <span>{f}</span>
        </li>
      ))}
    </ul>

    <!-- Push buttons to bottom -->
    <div class="flex-1"></div>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-1">
        {tags.map(tag => (
          <span
            class="text-xs px-2 py-0.5 rounded font-mono"
            style="background: var(--color-bg); color: var(--color-accent); border: 1px solid var(--color-border);"
          >
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Action buttons -->
    <div class="flex gap-3 pt-2">
      <button
        type="button"
        data-modal-target={modalId}
        class="flex-1 text-sm font-semibold px-4 py-2 rounded-lg transition-opacity hover:opacity-85"
        style="background: var(--color-accent); color: #0f172a;"
      >
        View Details
      </button>
      {status === 'live' && href && (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 text-sm font-semibold px-4 py-2 rounded-lg border text-center transition-colors hover:bg-[var(--color-card)]"
          style="border-color: var(--color-accent); color: var(--color-accent);"
        >
          Live Demo →
        </a>
      )}
    </div>
  </div>
</article>

<!-- ── Modal ──────────────────────────────────────────────────────── -->
<dialog
  id={modalId}
  class="rounded-xl p-0 shadow-2xl w-[calc(100%-2rem)] max-w-lg"
  style="background: var(--color-card); border: 1px solid var(--color-border); color: var(--color-text); margin: auto;"
>
  <!-- Header -->
  <div
    class="flex items-start justify-between p-6 pb-4"
    style="border-bottom: 1px solid var(--color-border);"
  >
    <div>
      <h2 class="text-xl font-bold" style="color: var(--color-text)">{title}</h2>
      <span
        class="inline-block mt-1.5 text-xs font-medium px-2.5 py-0.5 rounded-full"
        style={statusStyle[status]}
      >
        {statusLabel[status]}
      </span>
    </div>
    <button
      type="button"
      data-modal-close={modalId}
      class="transition-colors p-1 rounded-md"
      style="color: var(--color-muted);"
      aria-label="Close dialog"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Body -->
  <div class="p-6 space-y-5 overflow-y-auto" style="max-height: 60vh;">

    <!-- Full description -->
    <p class="text-sm leading-relaxed" style="color: var(--color-muted)">{description}</p>

    <!-- Features -->
    <div>
      <h3
        class="text-xs font-semibold uppercase tracking-widest mb-3"
        style="color: var(--color-accent)"
      >
        Features
      </h3>
      <ul class="space-y-2">
        {features.map(f => (
          <li class="flex items-start gap-2 text-sm" style="color: var(--color-muted)">
            <span class="flex-shrink-0 font-bold" style="color: var(--color-accent)">→</span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- What I learned -->
    {learned && (
      <div>
        <h3
          class="text-xs font-semibold uppercase tracking-widest mb-2"
          style="color: var(--color-accent)"
        >
          What I learned
        </h3>
        <p class="text-sm leading-relaxed italic" style="color: var(--color-muted)">{learned}</p>
      </div>
    )}

    <!-- Tech stack -->
    <div>
      <h3
        class="text-xs font-semibold uppercase tracking-widest mb-2"
        style="color: var(--color-accent)"
      >
        Tech Stack
      </h3>
      <div class="flex flex-wrap gap-1.5">
        {tags.map(tag => (
          <span
            class="text-xs px-2 py-0.5 rounded font-mono"
            style="background: var(--color-bg); color: var(--color-accent); border: 1px solid var(--color-border);"
          >
            {tag}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div
    class="p-6 pt-4 flex items-center gap-3"
    style="border-top: 1px solid var(--color-border);"
  >
    {status === 'live' && href && (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold px-5 py-2 rounded-lg transition-opacity hover:opacity-85"
        style="background: var(--color-accent); color: #0f172a;"
      >
        Live Demo →
      </a>
    )}
    {github && (
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium px-5 py-2 rounded-lg border transition-colors"
        style="border-color: var(--color-border); color: var(--color-muted);"
      >
        GitHub
      </a>
    )}
    <button
      type="button"
      data-modal-close={modalId}
      class="ml-auto text-sm font-medium px-5 py-2 rounded-lg border transition-colors"
      style="border-color: var(--color-border); color: var(--color-muted);"
    >
      Close
    </button>
  </div>
</dialog>

<style>
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
  }
</style>
