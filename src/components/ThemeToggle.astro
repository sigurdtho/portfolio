---
// ThemeToggle.astro
// A single icon button that switches between dark (Fjord Night) and light mode.
// Uses localStorage to persist the preference; also respects prefers-color-scheme
// as the initial default.
---

<button
  id="theme-toggle"
  aria-label="Toggle colour theme"
  title="Toggle colour theme"
  class="
    relative inline-flex items-center justify-center
    w-9 h-9 rounded-lg
    border border-transparent
    hover:border-[var(--color-border)]
    hover:bg-[var(--color-card)]
    text-muted hover:text-[var(--color-text)]
    transition-all duration-200
    focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]
  "
>
  <!-- Sun icon — shown in dark mode (click → go light) -->
  <svg
    id="icon-sun"
    class="w-5 h-5 hidden"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    stroke-width="1.8"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1"  x2="12" y2="3"  stroke-linecap="round" />
    <line x1="12" y1="21" x2="12" y2="23" stroke-linecap="round" />
    <line x1="4.22"  y1="4.22"  x2="5.64"  y2="5.64"  stroke-linecap="round" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" stroke-linecap="round" />
    <line x1="1"  y1="12" x2="3"  y2="12" stroke-linecap="round" />
    <line x1="21" y1="12" x2="23" y2="12" stroke-linecap="round" />
    <line x1="4.22"  y1="19.78" x2="5.64"  y2="18.36" stroke-linecap="round" />
    <line x1="18.36" y1="5.64"  x2="19.78" y2="4.22"  stroke-linecap="round" />
  </svg>

  <!-- Moon icon — shown in light mode (click → go dark) -->
  <svg
    id="icon-moon"
    class="w-5 h-5"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    stroke-width="1.8"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
    />
  </svg>
</button>

<script>
  const btn      = document.getElementById('theme-toggle')!;
  const iconSun  = document.getElementById('icon-sun')!;
  const iconMoon = document.getElementById('icon-moon')!;
  const html     = document.documentElement;

  function isDark() {
    return html.classList.contains('dark');
  }

  function applyTheme(dark: boolean) {
    html.classList.toggle('dark', dark);
    // Sun visible when dark (inviting you to switch to light)
    iconSun.classList.toggle('hidden', !dark);
    iconMoon.classList.toggle('hidden', dark);
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  }

  // Sync icon with current state on load
  applyTheme(isDark());

  btn.addEventListener('click', () => applyTheme(!isDark()));
</script>
