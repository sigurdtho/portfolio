---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Where to find me, or how to reach me if you have something to say."
>
  <div class="max-w-xl mx-auto">

    <!-- Page heading -->
    <div class="mb-10">
      <h1 class="text-4xl font-bold mb-3" style="color: var(--color-text)">Contact</h1>
      <p class="text-lg" style="color: var(--color-muted)">
        <!--
          TODO: Your preferred contact invite. Keep it real.
          Example: "If you have a question, a thought, or a book recommendation — email works."
        -->
        If you have a question, a thought, or a book recommendation — email works.
      </p>
    </div>

    <!-- ── Email ───────────────────────────────────────────────────────── -->
    <section class="card p-6 mb-5">
      <h2 class="text-sm uppercase tracking-widest mb-2" style="color: var(--color-accent)">Email</h2>
      <a
        href="mailto:sigurd14@gmail.com"
        class="text-lg font-medium hover:text-accent transition-colors"
        style="color: var(--color-text)"
      >
        <!-- TODO: Replace with your actual email address -->
        sigurd14@gmail.com
      </a>
      <p class="text-sm mt-2" style="color: var(--color-muted)">
        I read my email. I reply slower than I should, but I do reply.
      </p>
    </section>

    <!-- ── Social links ────────────────────────────────────────────────── -->
    <section class="card p-6 mb-5">
      <h2 class="text-sm uppercase tracking-widest mb-4" style="color: var(--color-accent)">Elsewhere</h2>

      <div class="flex flex-col gap-4">

        <!-- GitHub -->
        <a
          href="https://github.com/sigurdtho"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-sm hover:text-accent transition-colors group"
          style="color: var(--color-text)"
        >
          <!-- TODO: Replace href with your GitHub profile -->
          <svg class="w-5 h-5 text-muted group-hover:text-accent transition-colors flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2Z"/>
          </svg>
          <span>
            GitHub
            <span class="text-muted"> — code and the occasional experiment</span>
          </span>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/sigurd-thomassen/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-sm hover:text-accent transition-colors group"
          style="color: var(--color-text)"
        >
          <!-- TODO: Replace href with your LinkedIn profile -->
          <svg class="w-5 h-5 text-muted group-hover:text-accent transition-colors flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span>
            LinkedIn
            <span class="text-muted"> — professional, mostly</span>
          </span>
        </a>

      </div>
    </section>

    <!-- ── Note on response time ────────────────────────────────────────── -->
    <p class="text-sm text-center" style="color: var(--color-muted)">
      <!--
        TODO: Optional note. Or remove this entirely.
        Example: "Not on any social platforms in any meaningful way."
      -->
      Not on any social platforms in any meaningful way. Email is best.
    </p>

  </div>
</BaseLayout>
