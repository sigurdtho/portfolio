---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';

// ── Project data ────────────────────────────────────────────────────────────
const projects = [
  {
  title: 'LitTrack Pro',
  hook: 'A reading tracker with live leaderboards and physical bookmarks I designed myself. The kids are now actually choosing to read.',
  description: `Started as a plain Excel sheet to track how much my students were actually reading (15 min every single day). 
Turned into a Django app with live leaderboards and real physical bookmarks I designed myself. 
The kids are now properly hooked — one of the girls even asked me “What have you done to us?!”`,
  features: [
    'Live class leaderboard and individual reading progress',
    'Physical bookmark rewards for hitting page tiers',
    'Dead-simple way for me to log finished books',
    'Built to scale — multi-class and multi-school ready',
  ],
  tags: ['Python', 'Django', 'Tailwind', 'daisyUI', 'Render'],
  href: 'https://littrack.app/',
  github: undefined,
  status: 'live' as const,
  variant: 'littrack',
  learned: "Expanding it for multiple schools meant real data-migration pain and the first version wasn’t mobile-friendly at all. I leaned hard on different AI models throughout — Grok-4 for the heavy architecture lifts and Claude for polishing. Deploying a live app on Render with real student data taught me a lot about production readiness.",
},
  {
  title: 'Lovund Utleie',
  hook: 'A self-serve gear rental shop on Lovund — grab a kayak or e-scooter from the shed, pay on your phone, and go. No booking, no staff, no hassle.',
  description: `Lovund Utleie is the self-serve rental shop I built for outdoor gear on Lovund in Nordland. Customers just walk up to the shed at Hamnholmen, take whatever they need (bike, e-scooter, SUP board, kayak, drysuit…), pay quickly on their phone with card, Vipps, Apple Pay or Google Pay, and head off to explore. When they’re done they drop everything back in the shed. No booking system, no back-and-forth emails, no staff needed.

The whole idea was to make it as frictionless as possible — “Kom som du er” (come as you are). Open 24/7 during the season, first-come-first-served, and the site basically gets out of the way so people can just enjoy the island.`,
  features: [
    'Browse and rent bikes, e-scooters, SUP boards, kayaks and more — all from one simple shop',
    'Pay instantly on your phone (card, Vipps, Apple Pay, Google Pay)',
    "True self-serve: take gear from the shed, return it when you’re done — no staff required",
    '24/7 access during the season, no reservations needed'
  ],
  tags: ['TypeScript', 'Node.js', 'Tailwind', 'daisyUI', 'Stripe', 'Render'],
  href: 'https://lovundutleie.com/',
  github: undefined,
  status: 'live' as const,
  variant: 'lovund',
  learned: 'Integrating Stripe end-to-end (checkout sessions, webhooks, payment handling) was the biggest technical challenge and the most useful learning. Building for a real local business also forced me to focus on rock-solid error states, mobile-first design, and keeping the whole flow extremely simple for users who are literally standing outside in the rain.',
},
{
  title: 'Garden App',
  hook: "A mobile garden tracker I’m vibe-coding because my house is turning into a full-on plantation. First real Flutter app — Android + iOS.",
  description: `My wife has gone full gardening mode and our house is starting to look like a jungle. My brother-in-law threw out the idea of “just make an app to organize it all” and the lightbulb went off: I can just vibe-code this shit!

So I started building Garden App — my first proper mobile app that will work natively on both Android and iOS with Flutter. Right now it’s still very early and bare-bones, but the goal is a simple, useful tool to keep track of all the plants, planting dates, watering schedules, notes, harvests, the works.

It’s pure vibe-coding so far — optimistic and probably a bit naive, but that’s half the fun.`,
  features: [
    'Track plants, planting dates, watering schedules and notes',
    'Native Android + iOS app built with Flutter',
    'Simple, clean interface that actually feels good to use in the garden',
    'Built from day one to grow into something bigger (maybe even income-generating later)'
  ],
  tags: ['Flutter', 'Dart', 'Supabase', 'Mobile'],
  href: undefined,           // change to live demo link when you have one
  github: undefined,
  status: 'wip' as const,
  variant: 'garden',
  learned: 'I went in super optimistic (“I can just vibe-code this”). Even with AI help, turning a vague idea into a real cross-platform mobile app is a much bigger project than I expected. First time doing proper Flutter/Dart and thinking about mobile-specific stuff like offline support, nice UI on small screens, etc. Good learning though.',
},
  // ── Add future projects below ────────────────────────────────────────────
  // {
  //   title:       'My Next Project',
  //   hook:        'One-liner hook about the project.',
  //   description: 'Longer description for the modal.',
  //   features:    ['Feature one', 'Feature two', 'Feature three'],
  //   tags:        ['Tag1', 'Tag2'],
  //   href:        'https://example.com',
  //   github:      'https://github.com/you/project',
  //   status:      'wip',
  //   variant:     'default',
  //   learned:     'What I learned.',
  // },
];

// Extract all unique tags for the filter bar
const allTags = ['All', ...new Set(projects.flatMap(p => p.tags))];
---

<BaseLayout
  title="Projects"
  description="Things I have built — small projects, side experiments, and the occasional useful tool."
>

  <!-- Page header -->
  <div class="mb-10">
    <h1 class="text-4xl font-bold mb-3" style="color: var(--color-text)">Projects</h1>
    <p class="text-lg max-w-xl" style="color: var(--color-muted)">
      Small tools and projects I've built for myself or because something was bothering me at the time.
    </p>
  </div>

  <!-- ── Filter bar ────────────────────────────────────────────────────── -->
  <div
    class="flex flex-wrap gap-2 mb-10"
    id="filter-bar"
    role="group"
    aria-label="Filter projects by tag"
  >
    {allTags.map((tag, i) => (
      <button
        data-filter={tag}
        class={`
          filter-btn text-sm px-3 py-1.5 rounded-lg border transition-all duration-150 font-medium
          ${i === 0
            ? 'border-[var(--color-accent)] text-[var(--color-accent)] bg-[var(--color-card)]'
            : 'border-[var(--color-border)] text-muted hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]'
          }
        `}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >
        {tag}
      </button>
    ))}
  </div>

  <!-- ── Project grid ──────────────────────────────────────────────────── -->
  <div id="project-grid" class="grid sm:grid-cols-2 gap-6">
    {projects.map(project => (
      <div
        class="project-item"
        data-tags={JSON.stringify(project.tags)}
      >
        <ProjectCard
          title={project.title}
          hook={project.hook}
          description={project.description}
          features={project.features}
          tags={project.tags}
          href={project.href}
          github={project.github}
          status={project.status}
          variant={project.variant}
          learned={project.learned}
        />
      </div>
    ))}
  </div>

  <!-- Empty state -->
  <div id="empty-state" class="hidden text-center py-20">
    <p class="text-muted">No projects match that filter.</p>
  </div>

</BaseLayout>

<script>
  // ── Filter ──────────────────────────────────────────────────────────────
  const buttons  = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items    = document.querySelectorAll<HTMLElement>('.project-item');
  const emptyMsg = document.getElementById('empty-state')!;

  function filterProjects(activeTag: string) {
    let visible = 0;
    items.forEach(item => {
      const tags: string[] = JSON.parse(item.dataset.tags ?? '[]');
      const show = activeTag === 'All' || tags.includes(activeTag);
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    emptyMsg.classList.toggle('hidden', visible > 0);
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => {
        b.classList.remove('border-[var(--color-accent)]', 'text-[var(--color-accent)]', 'bg-[var(--color-card)]');
        b.classList.add('border-[var(--color-border)]', 'text-muted');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('border-[var(--color-accent)]', 'text-[var(--color-accent)]', 'bg-[var(--color-card)]');
      btn.classList.remove('border-[var(--color-border)]', 'text-muted');
      btn.setAttribute('aria-pressed', 'true');
      filterProjects(btn.dataset.filter ?? 'All');
    });
  });

  // ── Modals ──────────────────────────────────────────────────────────────
  document.addEventListener('click', e => {
    const target = e.target as HTMLElement;

    const openBtn = target.closest<HTMLElement>('[data-modal-target]');
    if (openBtn) {
      const dialog = document.getElementById(openBtn.dataset.modalTarget!) as HTMLDialogElement | null;
      dialog?.showModal();
      return;
    }

    const closeBtn = target.closest<HTMLElement>('[data-modal-close]');
    if (closeBtn) {
      const dialog = document.getElementById(closeBtn.dataset.modalClose!) as HTMLDialogElement | null;
      dialog?.close();
    }
  });

  // Close on backdrop click
  document.querySelectorAll('dialog').forEach(dialog => {
    dialog.addEventListener('click', e => {
      const rect = dialog.getBoundingClientRect();
      const outside =
        e.clientX < rect.left  || e.clientX > rect.right ||
        e.clientY < rect.top   || e.clientY > rect.bottom;
      if (outside) dialog.close();
    });
  });
</script>